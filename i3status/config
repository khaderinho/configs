general {
    colors = true
    interval = 1
}

order += "disk /"
order += "cpu_usage"
order += "memory"
order += "volume master"
order += "time"

disk "/" {
    format = "DISK %avail"
}

cpu_usage {
    format = "CPU %usage"
}

memory {
    format = "RAM %used"
}

volume master {
    format = "VOL %volume"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

time {
    format = "%a %b %d - %I:%M %p "
}
